# App
VITE_APP_URL=https://your-app-url.com

# Backend API (Hono + Drizzle + Railway Postgres)
VITE_API_URL=https://your-api-url.com

# Optional: public base URL for the asset bucket (Railway). Used to detect
# managed assets in the storage helper. If empty, asset deletion is best-effort.
VITE_BUCKET_PUBLIC_BASE_URL=

# Optional: Demo workspace (use only in dev; known credentials)
# VITE_ENABLE_DEMO_WORKSPACE=true

# Optional: Support email shown in app
# VITE_SUPPORT_EMAIL=support@example.com
